# =============================================================================
# Dockerfile.api — hosted FastAPI bridge for Fly.io (Phase 7.4, slimmed 8.6)
#
# Ships the transparent-strategy engine only: the LibTorch-free `backtest`
# binary and API-only Python deps (no torch — gigabytes smaller, faster cold
# starts). The experimental ML strategy is not available on this image; it
# returns a clear 400, and the extension labels it accordingly. A model
# volume can still be mounted at /app/models for future experimental images.
#
# OHLCV fetched on demand is cached inside the container filesystem
# (backtester/data/ohlcv/) — rebuilt after redeploys; move to the volume if
# that ever matters.
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY research/ ./research/
COPY backtester/backtest ./backtester/backtest
COPY backtester/data/ ./backtester/data/
COPY backtest_config.yaml .

RUN chmod +x ./backtester/backtest

ENV PROJECT_ROOT=/app

EXPOSE 8080

CMD ["uvicorn", "research.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
