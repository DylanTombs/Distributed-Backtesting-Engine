[run]
source = research
omit =
    # Legacy: transformer training code, kept as a record of how the model was
    # built. Not on the product path and intentionally unexercised — its tests
    # were removed with the training pipeline.
    research/transformer/*
    # Reference oracle for the C++ RuleStrategy indicators; exercised
    # indirectly through tests/test_indicator_crossval.py.
    research/features/technicalIndicators.py
    research/api/runner.py

[report]
fail_under = 80
